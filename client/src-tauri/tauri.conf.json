{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "K-Room",
  "version": "0.1.0",
  "identifier": "space.kroom.client",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:43101",
    "beforeDevCommand": "pnpm run serve:tauri",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "K-Room",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
