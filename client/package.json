{
  "name": "k-room-client",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "serve": "vite --host",
    "build": "tsc && vite build",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint:fix-style": "stylelint **/*.scss --fix",
    "lint:es": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix-es": "eslint src --ext ts,tsx --fix",
    "lint:all": "npm run lint:es && npm run lint:style",
    "lint:fix-all": "npm run lint:fix-es && npm run lint:fix-style",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@sentry/react": "^10.45.0",
    "antd": "5.24.4",
    "axios": "^1.13.6",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "firebase": "^9.23.0",
    "howler": "^2.2.4",
    "js-cookie": "^3.0.5",
    "moment": "^2.30.1",
    "react-virtuoso": "^4.18.3",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.5.1",
    "vite-plugin-pwa": "^0.21.1"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^1.8.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/howler": "^2.2.7",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.20",
    "@types/node": "^25.5.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@types/react-redux": "^7.1.24",
    "@types/simple-peer": "^9.11.5",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.30.1",
    "history": "^5.3.0",
    "jsdom": "^29.0.1",
    "lodash": "^4.17.21",
    "postcss": "^8.4.16",
    "postcss-sorting": "^7.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "^8.0.2",
    "react-rnd": "^10.4.1",
    "react-router-dom": "^6.3.0",
    "sass": "^1.85.0",
    "simple-peer": "^9.11.1",
    "stylelint": "14.5.1",
    "stylelint-config-clean-order": "^7.0.0",
    "stylelint-config-prettier-scss": "^0.0.1",
    "stylelint-config-standard-scss": "3.0.0",
    "typescript": "^5.0.2",
    "vite": "^4.3.8",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.1"
  }
