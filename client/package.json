{
  "name": "k-room-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "serve": "vite --host",
    "serve:tauri": "vite --host ${TAURI_DEV_HOST:-127.0.0.1} --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "pnpm run typecheck",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint:fsd": "CHOKIDAR_USEPOLLING=1 steiger ./src",
    "lint:fsd:watch": "CHOKIDAR_USEPOLLING=1 steiger ./src --watch",
    "lint:style": "pnpm --dir .. exec stylelint \"client/src/**/*.{css,vue}\"",
    "lint:fix-style": "pnpm --dir .. exec stylelint \"client/src/**/*.{css,vue}\" --fix",
    "lint:es": "pnpm --dir .. exec eslint --config .eslintrc.cjs \"client/src/**/*.{ts,vue}\"",
    "lint:fix-es": "pnpm --dir .. exec eslint --config .eslintrc.cjs client/src --ext ts,vue --fix",
    "lint:all": "pnpm run lint:fsd && pnpm run lint:es && pnpm run lint:style",
    "lint:fix-all": "pnpm run lint:fix-es && pnpm run lint:fix-style",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@primevue/forms": "^4.5.5",
    "@tanstack/vue-virtual": "^3.13.24",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.15.2",
    "dexie": "^4.4.2",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "firebase": "^12.12.1",
    "global-shared": "workspace:*",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "socket.io-client": "^4.8.3",
    "valibot": "^1.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@tauri-apps/cli": "2.10.1",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "steiger": "^0.5.11",
    "typescript": "^5.9.2",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.2.0",
    "vue-tsc": "^2.1.10"
  }
}
