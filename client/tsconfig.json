{
  "compilerOptions": {
    "outDir": "./build/",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "es6",
    "target": "es5",
    "allowJs": true,
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strictNullChecks": false,
    "baseUrl": "./../",
    "paths": {
      "src/*": ["client/src/*"],
      "common-types": ["types"],
      "ui/*": ["client/src/components/UI/*"]
    }
  },
  "references": [
    {
      "path": "./../types/"
    }
  ]
}
