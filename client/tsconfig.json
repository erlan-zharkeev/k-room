{
  "compilerOptions": {
    "outDir": "./bundle/",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "es6",
    "target": "es5",
    "allowJs": true,
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": "./../",
    "paths": {
      "src/*": ["client/src/*"],
      "common-types": ["types"]
    }
  },
  "references": [
    {
      "path": "./../types/"
    }
  ]
}
