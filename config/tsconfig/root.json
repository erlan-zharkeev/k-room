{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "paths": {
      "common": ["../../common/index.ts"],
      "e2e/*": ["../../e2e/*"]
    },
    "types": ["node", "@playwright/test"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["../../config/playwright/**/*.ts", "../../e2e/**/*.ts"]
}
