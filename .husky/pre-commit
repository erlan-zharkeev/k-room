#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

STAGED_FILES="$(mktemp)"

cleanup() {
  rm -f "$STAGED_FILES"
}

trap cleanup EXIT INT TERM

git diff --cached --name-only --diff-filter=d -z > "$STAGED_FILES"

pnpm run sync:public-config &&
  if [ -s "$STAGED_FILES" ]; then
    git add --pathspec-from-file="$STAGED_FILES" --pathspec-file-nul
  fi &&
  pnpm run check
