{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./",
    "baseUrl": ".",
    "module": "ESNext",
    "declaration": true,
    "composite": true,
    "moduleResolution": "node",
    "paths": {
      "common": ["./index.ts"],
      "common/*": ["./*"]
    }
  },
  "include": ["./index.ts", "./types", "./lib", "./user", "./endpoints"],
  "exclude": ["node_modules"]
}
