{
  "name": "k-room-server",
  "version": "1.0.0",
  "main": "build/main.js",
  "license": "MIT",
  "scripts": {
    "serve": "cross-env TS_NODE_PROJECT=tsconfig.runtime.json nest start --watch --exec \"node -r tsconfig-paths/register\"",
    "start": "cross-env TS_NODE_PROJECT=tsconfig.runtime.json nest start --exec \"node -r tsconfig-paths/register\"",
    "start:prod": "cross-env TS_NODE_PROJECT=tsconfig.runtime.json node -r tsconfig-paths/register build/main.js",
    "build": "cross-env NODE_ENV=production nest build",
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "_typecheck": "Nest build emits code; this keeps a separate noEmit typecheck step",
    "lint:es": "pnpm --dir .. exec eslint --config .eslintrc.cjs \"server/src/**/*.ts\"",
    "lint:fix-es": "pnpm --dir .. exec eslint --config .eslintrc.cjs server/src --ext ts --fix"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/mongoose": "^4.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@nestjs/websockets": "^10.0.0",
    "@sentry/node": "^10.45.0",
    "@socket.io/redis-adapter": "8.3.0",
    "adminjs": "^7.8.17",
    "bcryptjs": "^3.0.2",
    "cli-color": "^2.0.3",
    "connect-mongo": "^5.1.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.18.2",
    "file-type": "^16.5.4",
    "global-shared": "workspace:*",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "method-override": "^3.0.0",
    "mime-types": "^3.0.1",
    "mongoose": "^8.23.0",
    "multer": "1.4.5-lts.1",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.6.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.32.1",
    "socket.io": "^4.5.1",
    "uuid": "^9.0.0",
    "valibot": "^1.3.1"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "5.3.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cli-color": "^2.0.6",
    "@types/cookie": "^1.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/method-override": "^3.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.10",
    "@types/socket.io": "^3.0.2",
    "@types/uuid": "^10.0.0",
    "body-parser": "^1.20.1",
    "cross-env": "^7.0.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
