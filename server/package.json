{
  "name": "k-room-server",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "serve": "cross-env NODE_ENV=development node --watch --import tsx src/index.ts",
    "serve:e2e": "cross-env NODE_ENV=development node --import tsx src/index.ts",
    "prebuild": "npm --prefix .. run sync:public-config",
    "build": "cross-env NODE_ENV=production tsup src/index.ts --format cjs --platform node --target node24 --out-dir build --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "server-run": "cross-env NODE_ENV=production node ./build/index.js",
    "lint:fix-es": "eslint '**/*.ts' --fix"
  },
  "dependencies": {
    "@sentry/node": "^10.45.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^6.14.2",
    "file-type": "^16.5.4",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "method-override": "^3.0.0",
    "mime-types": "^3.0.1",
    "mongoose": "^6.4.2",
    "multer": "1.4.5-lts.1",
    "resend": "^4.6.0",
    "sharp": "^0.32.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cli-color": "^2.0.6",
    "@types/cookie": "^1.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/method-override": "^3.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.10",
    "@types/socket.io": "^3.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "body-parser": "^1.20.1",
    "cli-color": "^2.0.3",
    "cookie": "^1.0.2",
    "cross-env": "^7.0.3",
    "eslint": "8.57.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "socket.io": "^4.5.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
