{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "modules/fixtures/images/**/*",
        "outDir": "build"
      },
      {
        "include": "modules/media/admin-components/**/*",
        "outDir": "build"
      }
    ]
  }
}
