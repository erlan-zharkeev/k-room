{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./build/",
    "module": "commonjs",
    "noImplicitAny": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
    // "baseUrl": "./../"
    // "paths": {
    //   "src/*": ["./../server/src/*"],
    //   "models/*": ["./../server/src/models/*"]
    //   // "common-types": ["types/*"]
    // }
  },
  "include": ["src"],
  // "references": [{ "path": "./tsconfig.node.json" }],
  "references": [
    {
      "path": "./../types/"
    }
  ]
}
