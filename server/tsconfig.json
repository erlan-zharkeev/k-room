{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./build/",
    "module": "commonjs",
    "allowJs": true,
    "baseUrl": "./../",
    "lib": ["ESNext.AsyncIterable", "ESNext.Disposable"],
    "paths": {
      "app/*": ["server/src/app/*"],
      "features/*": ["server/src/features/*"],
      "entities/*": ["server/src/entities/*"],
      "shared-config": ["server/src/shared/config"],
      "shared-lib": ["server/src/shared/lib"],
      "shared-middleware": ["server/src/shared/middleware"],
      "common-types": ["types"]
    }
  },
  "include": ["../server/src", "../types/shared-types", "**/*.cjs"],
  "exclude": ["node_modules", "./build", "./src/utils"]
}
