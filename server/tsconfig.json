{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "module": "node16",
    "allowJs": true,
    "lib": ["ESNext.AsyncIterable", "ESNext.Disposable"],
    "paths": {
      "src/*": ["./src/*"],
      "common": ["../common/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "./build"]
}
