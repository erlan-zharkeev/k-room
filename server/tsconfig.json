{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "module": "commonjs",

    "noImplicitAny": true,
    // "module": "es6",
    // "target": "es6",

    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "baseUrl": "./../",
    "paths": {
      "src/*": ["server/src/*"],
      "common-types": ["types"]
    }
  },
  "references": [
    {
      "path": "./../types/"
    }
  ]
}
