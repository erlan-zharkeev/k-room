{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./build/",
    "module": "commonjs",
    "allowJs": true,
    "baseUrl": "./../",
    "lib": ["ESNext.AsyncIterable", "ESNext.Disposable"],
    "paths": {
      "src/*": ["server/src/*"],
      "common": ["common/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "./build", "./src/utils"]
}
