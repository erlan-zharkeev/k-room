{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./build/",
    "module": "commonjs",
    "noImplicitAny": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": "./../",
    "paths": {
      "app/*": ["server/src/app/*"],
      "features/*": ["server/src/features/*"],
      "entities/*": ["server/src/entities/*"],
      "shared-config": ["server/src/shared/config"],
      "shared-lib": ["server/src/shared/lib"],
      "shared-middleware": ["server/src/shared/middleware"],
      "common-types": ["types"]
    }
  },
  "include": ["../server/src", "../types/shared-types", "**/*.cjs"],
  "exclude": ["node_modules", "./build", "./src/utils"]
}
