{
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "src/*": ["./src/*"]
    },
    "types": ["node", "vitest/globals"],
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "vitest.config.mts"],
  "exclude": ["node_modules", "build"]
}
