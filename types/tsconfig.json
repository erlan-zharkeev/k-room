{
  "compilerOptions": {
    "outDir": "./",
    "rootDir": "./../",
    "module": "ESNext",
    "target": "ES2015",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "declaration": true,
    "composite": true,
    "moduleResolution": "node"
  },
  "include": ["./shared-types/**/*.ts", "index.ts"],
  "exclude": [
    "node_modules",
    "Makefile",
    "readme.md",
    "yarn-error",
    "yarn-lock"
  ]
}
