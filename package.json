{
  "name": "k-room",
  "private": true,
  "version": "1.0.0",
  "repository": "git@github.com:erlan-zharkeev/k-room.git",
  "author": "<aurora.nex.axis@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "client",
    "global-shared",
    "server"
  ],
  "pnpm": {
    "overrides": {
      "@tiptap/core": "2.27.2",
      "@tiptap/pm": "2.27.2"
    },
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@nestjs/core",
      "@parcel/watcher",
      "@pnpm/exe",
      "@swc/core",
      "es5-ext",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:server": "node scripts/dev.mjs --server-only",
    "preview:dev": "node scripts/dev.mjs --preview",
    "update:nmorph": "pnpm --dir client add @nmorph/nmorph-ui-kit@latest && pnpm --filter k-room-client build",
    "husky-prepare": "husky install",
    "sync:public-config": "node scripts/sync-public-config.mjs",
    "format:fix": "prettier --write .",
    "format:staged": "node scripts/format-staged.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck typecheck:test",
    "lint:es": "turbo run lint:es && eslint --config .eslintrc.cjs \"e2e/**/*.ts\" playwright.config.ts",
    "lint:style": "turbo run lint:style",
    "lint:fsd": "turbo run lint:fsd",
    "lint:all": "pnpm run lint:fsd && pnpm run lint:es && pnpm run lint:style",
    "lint:fsd:watch": "pnpm --dir client run lint:fsd:watch",
    "lint:fix": "turbo run lint:fix-es && turbo run lint:fix-style",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:ui": "playwright test -c playwright.config.ts --ui",
    "smoke": "playwright test -c playwright.config.ts --grep @smoke",
    "check": "pnpm run lint:fsd && pnpm run lint:es && pnpm run lint:style && turbo run typecheck typecheck:test build test && prettier --check .",
    "deploy": "node scripts/deploy/create-production-deploy-commit.mjs",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.9.0",
    "husky": "^8.0.2",
    "postcss-html": "^1.8.1",
    "prettier": "^2.8.8",
    "stylelint": "^17.6.0",
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "turbo": "^2.9.6",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.0"
  }
}
