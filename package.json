{
  "name": "k-room",
  "version": "1.0.0",
  "repository": "git@gitlab.com:k-room/k-room.git",
  "author": "<zharkeev.post@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "zsh scripts/dev.sh",
    "prepare": "husky install",
    "sync:public-config": "node scripts/sync-public-config.mjs",
    "format:check": "client/node_modules/.bin/prettier --check .",
    "client:lint": "client/node_modules/.bin/eslint client/src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "client:stylelint": "npm --prefix client run lint:style",
    "client:build": "npm --prefix client run build",
    "client:test": "npm --prefix client run test",
    "client:test:watch": "npm --prefix client run test:watch",
    "server:lint": "npm --prefix server run lint",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:build": "npm --prefix server run build",
    "e2e": "playwright test -c config/playwright/playwright.config.ts",
    "e2e:ui": "playwright test -c config/playwright/playwright.config.ts --ui",
    "check": "npm run client:lint && npm run client:stylelint && npm run client:build && npm run server:lint && npm run server:typecheck && npm run server:build",
    "test": "npm run client:test",
    "test:watch": "npm run client:test:watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "depcheck": "^1.4.7",
    "husky": "^8.0.2"
  }
}
